{
  "name": "@kubohiroya/turbowarp-plus-editor-project-folder",
  "version": "0.9.0",
  "description": "Read and save expanded Scratch project folders in TurboWarp Plus Editor",
  "type": "module",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-plus-editor-project-folder.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./explorer": {
      "types": "./dist/explorer.d.ts",
      "default": "./dist/explorer.js"
    }
  },
  "files": [
    "dist",
    "src",
    "vite.config.ts",
    "tsconfig.json",
    "README.ja.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.js",
    "prepack": "npm run build",
    "test:browser": "npm run build && node --test test/*.browser.js"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/merge": "6.12.3",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@headless-tree/core": "1.8.0",
    "@headless-tree/react": "1.8.0",
    "@kubohiroya/sb3-toolchain": "0.22.0",
    "@kubohiroya/turbowarp-plus-editor-test-runtime": "0.1.0",
    "@lezer/highlight": "1.2.5",
    "@playwright/test": "1.64.1",
    "@types/react": "16.14.62",
    "@types/react-dom": "16.9.24",
    "react": "16.14.0",
    "react-dom": "16.14.0",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  },
  "peerDependencies": {
    "react": ">=16.14 <19",
    "react-dom": ">=16.14 <19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
