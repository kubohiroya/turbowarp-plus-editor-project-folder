{
  "name": "@kubohiroya/turbowarp-plus-editor-project-folder",
  "version": "0.3.0",
  "description": "Read and save expanded Scratch project folders in TurboWarp Plus Editor",
  "type": "module",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-plus-editor-project-folder.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "vite.config.ts",
    "tsconfig.json",
    "README.ja.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json",
    "test": "npm run build && node --test",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
